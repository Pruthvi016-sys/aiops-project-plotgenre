# Copy to .env (scripts/setup.sh does this and generates the secrets for you).
# API key shared by the frontend proxy, gateway and pipeline runner.
API_KEY=change-me-to-a-long-random-string
# Fernet key used to encrypt the stored model artifact. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PLOTGENRE_MODEL_KEY=
# Run containers as your user so files written to the project stay yours.
UID=1000
GID=1000
# Grafana admin password
GRAFANA_ADMIN_PASSWORD=admin
